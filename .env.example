# Copy to `.env` for local tooling. Never commit the real `.env`.
# Ritual has no server-side secrets: the app is fully offline. These values
# are only used by build/CI tooling.

# Environment flag read by src/config/environment.ts
APP_ENV=development

# EAS project id (also mirrored in app.json -> expo.extra.eas.projectId).
# Created by `eas init`; leave the placeholder out of committed files.
EXPO_EXTRA_EAS_PROJECT_ID=

# Only required when running `eas submit`. The key file itself is gitignored.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json

# Set to "1" in CI to enable stricter, slower checks.
CI=
